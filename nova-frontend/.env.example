# Supabase
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# TMDB (only needed if calling TMDB directly from frontend — normally proxied via backend)
VITE_TMDB_API_KEY=your_tmdb_api_key

# Optional features
VITE_ENABLE_EMAIL_POPUP=false

# Vercel Production API URL (Required for separate frontend/backend deploys)
VITE_API_URL=https://nova-backend.vercel.app

# Cloudflare Turnstile — https://dash.cloudflare.com/?to=/:account/turnstile
# Test keys (always pass): site=1x00000000000000000000AA  secret=1x0000000000000000000000000000000AA
VITE_TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key
