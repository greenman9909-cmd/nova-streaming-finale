{
  "buildCommand": "cd nova-frontend && npm run build && mkdir -p ../api && cp api/index.mjs ../api/index.mjs",
  "outputDirectory": "nova-frontend/dist",
  "installCommand": "cd nova-frontend && npm install --legacy-peer-deps",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
