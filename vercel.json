{
  "version": 2,
  "buildCommand": "cd nova-frontend && npm install && npm run build",
  "outputDirectory": "nova-frontend/dist",
  "installCommand": "cd nova-backend && npm install",
  "functions": {
    "nova-backend/api/index.ts": {
      "runtime": "nodejs20.x",
      "maxDuration": 30,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/nova-backend/api/index.ts"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
